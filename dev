#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

BUILD_DIR="${BUILD_DIR:-build/dev}"
SANITIZER_DIR="${SANITIZER_DIR:-build/asan}"
JOBS="${JOBS:-4}"
if command -v ccache >/dev/null 2>&1; then
  export CMAKE_CXX_COMPILER_LAUNCHER="${CMAKE_CXX_COMPILER_LAUNCHER:-ccache}"
fi
# CI pins this exact version through pip, so a local mismatch means a surprise
# failure later. Homebrew's llvm@23 is the same release.
CLANG_FORMAT_VERSION="${CLANG_FORMAT_VERSION:-23.1.1}"

log() { printf '==> %s\n' "$*"; }
die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

find_tool() {
  local name="$1"
  shift
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  for candidate in "$@"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

clang_format_tool() {
  find_tool clang-format \
    /opt/homebrew/opt/llvm@23/bin/clang-format \
    /opt/homebrew/opt/llvm/bin/clang-format \
    /usr/local/opt/llvm/bin/clang-format || die "clang-format not found"
}

source_files() {
  find include src tests examples test_package -path '*/build' -prune -o -type f \( -name '*.cpp' -o -name '*.hpp' \) -print | sort
}

# Templates are checked through tests; runtime implementations are checked directly.
tidy_files() {
  find src tests -maxdepth 1 -type f -name '*.cpp' | sort
}

usage() {
  cat <<'EOF'
Usage: ./dev <command> [options]

Commands:
  format [--fix]        Check formatting (--fix rewrites the files)
  configure [dir]       Configure a build directory
  build [dir] [target]  Build a directory, or one target
  test [dir] [regex] [--all]
                        Run tests (excludes packaging; --all includes it)
  tidy [--fix] [--changed | files...]
                        Analyze all translation units, changed files, or named files
  sanitizer [--configure-only]
                        Build and test with ASan and UBSan
  thread-sanitizer [--configure-only]
                        Build and test with ThreadSanitizer
  linux-check [target] [regex]
                        Incremental Ubuntu GCC check in Docker (full by default)
  check                 Format check, configure, build, and test
  clean                 Remove the build directories

Extra arguments after a directory are passed to CMake, for example:
  ./dev configure build/dev -DCMAKE_CXX_COMPILER=clang++

Environment:
  BUILD_DIR             Default build directory (build/dev)
  JOBS                  Parallel compilation/analysis jobs (default: 4)
  CAIL_BUILD_EXAMPLES   Build examples during configure (default: OFF)
  CAIL_FETCHCONTENT_BASE_DIR
                        Reuse a shared dependency checkout
EOF
}

cmd_format() {
  local clang_format
  clang_format="$(clang_format_tool)"
  local fix=false
  [[ "${1:-}" == "--fix" ]] && fix=true

  local version
  version="$("$clang_format" --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
  if [[ "$version" != "$CLANG_FORMAT_VERSION" ]]; then
    printf 'warning: clang-format %s found, CI uses %s\n' "$version" "$CLANG_FORMAT_VERSION" >&2
  fi

  log "format (clang-format $version)"
  local files
  files="$(source_files)"
  [[ -n "$files" ]] || die "no source files found"
  if $fix; then
    # shellcheck disable=SC2086
    "$clang_format" -i $files
  else
    # shellcheck disable=SC2086
    "$clang_format" --dry-run --Werror $files
  fi
}

cmd_configure() {
  local dir="$BUILD_DIR"
  if [[ $# -gt 0 && "$1" != -* ]]; then
    dir="$1"
    shift
  fi
  local cache=()
  # Reuse a shared dependency checkout so CI and local builds skip the clone.
  [[ -n "${CAIL_FETCHCONTENT_BASE_DIR:-}" ]] &&
    cache+=("-DFETCHCONTENT_BASE_DIR=$CAIL_FETCHCONTENT_BASE_DIR")
  [[ -n "${CMAKE_CXX_COMPILER_LAUNCHER:-}" ]] &&
    cache+=("-DCMAKE_CXX_COMPILER_LAUNCHER=$CMAKE_CXX_COMPILER_LAUNCHER")
  log "configure ($dir)"
  cmake -S . -B "$dir" -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Debug}" \
    -DCAIL_BUILD_EXAMPLES="${CAIL_BUILD_EXAMPLES:-OFF}" -DBUILD_TESTING=ON \
    ${cache[@]+"${cache[@]}"} ${1+"$@"}
}

cmd_build() {
  local dir="${1:-$BUILD_DIR}"
  local target="${2:-}"
  log "build ($dir${target:+ $target})"
  cmake --build "$dir" --parallel "$JOBS" ${target:+--target "$target"}
}

cmd_test() {
  local dir="$BUILD_DIR"
  local args=(--label-exclude packaging --no-tests=error)
  if [[ $# -gt 0 && "$1" != --all ]]; then
    dir="$1"
    shift
  fi
  if [[ $# -gt 0 && "$1" != --all ]]; then
    args+=(-R "$1")
    shift
  fi
  if [[ "${1:-}" == --all ]]; then
    args=("${args[@]:2}")
    shift
  fi
  [[ $# -eq 0 ]] || die "usage: ./dev test [dir] [regex] [--all]"
  log "test ($dir)"
  ctest --test-dir "$dir" --output-on-failure --output-junit results.xml "${args[@]}"
}

cmd_tidy() {
  local clang_tidy
  clang_tidy="$(find_tool clang-tidy \
    /opt/homebrew/opt/llvm@23/bin/clang-tidy \
    /opt/homebrew/opt/llvm/bin/clang-tidy \
    /usr/local/opt/llvm/bin/clang-tidy)" || die "clang-tidy not found"
  [[ -f "$BUILD_DIR/compile_commands.json" ]] ||
    die "missing $BUILD_DIR/compile_commands.json; run ./dev configure first"

  local args=(-p "$BUILD_DIR" -quiet)
  local line_filter
  line_filter="$(python3 -c 'import json, pathlib; print(json.dumps([{"name": str(path.resolve()), "lines": [[1, 1000000]]} for folder in ("include", "src") for path in pathlib.Path(folder).rglob("*") if path.suffix in {".h", ".hpp", ".cpp"}]))')"
  args+=(--line-filter="$line_filter")
  local tidy_jobs="$JOBS"
  if [[ "${1:-}" == "--fix" ]]; then
    args+=(-fix)
    tidy_jobs=1
    shift
  fi

  local sdkroot
  sdkroot="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null || true)"
  if [[ -n "$sdkroot" ]]; then
    args+=(-extra-arg=-isysroot -extra-arg="$sdkroot")
    # Match Apple Clang's implicit includes when using Homebrew clang-tidy.
    local libcxx="$(dirname "$(xcrun --find clang++)")/../include/c++/v1"
    [[ -d "$libcxx" ]] && args+=(-extra-arg=-isystem -extra-arg="$libcxx")
    [[ -d /usr/local/include ]] && args+=(-extra-arg=-I/usr/local/include)
  fi

  local files
  if [[ "${1:-}" == --changed ]]; then
    [[ $# -eq 1 ]] || die "use --changed or explicit files"
    local changed
    changed="$( { git diff --name-only --diff-filter=ACMR HEAD; git diff --name-only --diff-filter=D HEAD -- '*.h' '*.hpp'; git ls-files --others --exclude-standard; } | sort -u)"
    if printf '%s\n' "$changed" | grep -Eq '^(include|src|tests)/.*\.(h|hpp)$|^(CMakeLists.txt|\.clang-tidy)$'; then
      files="$(tidy_files)"
    else
      files="$(printf '%s\n' "$changed" | grep -E '^(src|tests)/[^/]+\.cpp$' || true)"
    fi
  elif [[ $# -gt 0 ]]; then
    files="$(printf '%s\n' "$@")"
  else
    files="$(tidy_files)"
  fi
  [[ -n "$files" ]] || { log "tidy (no changed translation units)"; return 0; }
  log "tidy ($(echo "$files" | wc -l | tr -d ' ') translation units)"
  # shellcheck disable=SC2086
  printf '%s\n' $files | xargs -n 1 -P "$tidy_jobs" "$clang_tidy" "${args[@]}"
}

cmd_sanitizer() {
  local configure_only=false
  if [[ "${1:-}" == --configure-only ]]; then
    configure_only=true
    shift
  fi
  log "sanitizer ($SANITIZER_DIR)"
  local flags="${SANITIZER_FLAGS:--fsanitize=address,undefined -fno-omit-frame-pointer -g}"
  local cache=()
  [[ -n "${CAIL_FETCHCONTENT_BASE_DIR:-}" ]] &&
    cache+=("-DFETCHCONTENT_BASE_DIR=$CAIL_FETCHCONTENT_BASE_DIR")
  [[ -n "${CMAKE_CXX_COMPILER_LAUNCHER:-}" ]] &&
    cache+=("-DCMAKE_CXX_COMPILER_LAUNCHER=$CMAKE_CXX_COMPILER_LAUNCHER")
  cmake -S . -B "$SANITIZER_DIR" -DCMAKE_BUILD_TYPE=Debug \
    -DCAIL_BUILD_EXAMPLES=OFF -DBUILD_TESTING=ON \
    -DCMAKE_CXX_FLAGS="$flags" -DCMAKE_EXE_LINKER_FLAGS="$flags" \
    ${cache[@]+"${cache[@]}"} "$@"
  $configure_only && return 0
  cmd_build "$SANITIZER_DIR"
  cmd_test "$SANITIZER_DIR" --all
}

cmd_linux_check() {
  command -v docker >/dev/null 2>&1 || die "docker is required for linux-check"
  local image="cail-linux-gcc-check"
  local ccache_volume="cail-linux-check-ccache"
  local deps_volume="cail-linux-check-fetchcontent"
  local build_volume="cail-linux-check-build"
  [[ $# -le 2 ]] || die "usage: ./dev linux-check [target] [regex]"

  log "build Linux GCC check image"
  docker build -f "$ROOT/ci/linux-gcc.Dockerfile" -t "$image" "$ROOT/ci"
  docker volume create "$ccache_volume" >/dev/null
  docker volume create "$deps_volume" >/dev/null
  docker volume create "$build_volume" >/dev/null

  log "linux-check (Ubuntu 24.04, GCC)"
  docker run --rm \
    --env JOBS="$JOBS" \
    --env CAIL_BUILD_EXAMPLES="${CAIL_BUILD_EXAMPLES:-ON}" \
    --volume "$ROOT:/src:ro" \
    --volume "$ccache_volume:/root/.cache/ccache" \
    --volume "$deps_volume:/root/.cache/cail-fetchcontent" \
    --volume "$build_volume:/build" \
    --workdir /src \
    "$image" bash -lc '
      set -euo pipefail
      export CAIL_FETCHCONTENT_BASE_DIR=/root/.cache/cail-fetchcontent
      export CCACHE_MAXSIZE=1G
      export CXX=g++
      ./dev configure /build -G Ninja -DCMAKE_CXX_COMPILER_LAUNCHER=ccache
      ./dev build /build "${1:-}"
      ./dev test /build "${2:-.*}" --all
      ccache --show-stats
    ' bash "$@"
}

cmd_check() {
  cmd_format
  cmd_configure "$BUILD_DIR"
  cmd_build "$BUILD_DIR"
  cmd_test "$BUILD_DIR"
}

cmd_clean() {
  log "clean"
  rm -rf "$BUILD_DIR" "$SANITIZER_DIR"
}

[[ $# -ge 1 ]] || {
  usage
  exit 1
}
command="$1"
shift
case "$command" in
  format) cmd_format "$@" ;;
  configure) cmd_configure "$@" ;;
  build) cmd_build "$@" ;;
  test) cmd_test "$@" ;;
  tidy) cmd_tidy "$@" ;;
  sanitizer) cmd_sanitizer "$@" ;;
  linux-check) cmd_linux_check "$@" ;;
  thread-sanitizer)
    SANITIZER_DIR="${THREAD_SANITIZER_DIR:-build/tsan}" \
      SANITIZER_FLAGS="-fsanitize=thread -fno-omit-frame-pointer -g" cmd_sanitizer "$@"
    ;;
  check) cmd_check "$@" ;;
  clean) cmd_clean "$@" ;;
  -h | --help | help) usage ;;
  *) die "unknown command: $command" ;;
esac
