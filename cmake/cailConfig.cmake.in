@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Minimum versions, not exact ones: a consumer that already depends on a newer
# Glaze or magic_enum must stay resolvable.
find_dependency(glaze 8.4.0 CONFIG REQUIRED)
glaze_setup_asio()
find_dependency(magic_enum CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/cailTargets.cmake")
target_link_libraries(cail::cail INTERFACE glaze::asio)
check_required_components(cail)
